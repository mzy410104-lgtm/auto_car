# Existing temporary downloads, rendered pages, and local preparation files.
/tmp/

# Local-only configuration and large raw recordings. Keep acquisition instructions.
/.local/
/data/raw/*
!/data/raw/README.md
.env
.env.*
!.env.example

# Original manufacturer downloads remain local; track SOURCE_INDEX.md instead.
/sources/**/*.pdf
/sources/**/*.stp
/sources/**/*.dxf
/sources/planning/

# Keil MDK generated output and per-user interface state.
/firmware/auto_car/MDK-ARM/auto_car/
/firmware/auto_car/MDK-ARM/*.uvguix.*
/firmware/auto_car/MDK-ARM/*.lst
